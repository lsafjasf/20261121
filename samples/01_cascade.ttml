<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml"
    xmlns:tts="http://www.w3.org/ns/ttml#styling"
    xmlns:ttp="http://www.w3.org/ns/ttml#parameter"
    xmlns:ttm="http://www.w3.org/ns/ttml#metadata"
    xmlns:xml="http://www.w3.org/XML/1998/namespace"
    ttp:frameRate="25" ttp:cellResolution="32 18" xml:lang="en">
  <head>
    <metadata>
      <ttm:agent xml:id="narrator" type="person">
        <ttm:name type="full">Narrator</ttm:name>
      </ttm:agent>
      <ttm:agent xml:id="alice" type="person">
        <ttm:name type="full">Alice</ttm:name>
      </ttm:agent>
    </metadata>
    <styling>
      <style xml:id="base" tts:fontFamily="sansSerif" tts:fontSize="100%" tts:color="white"/>
      <style xml:id="loud" tts:fontWeight="bold" tts:color="yellow"/>
      <style xml:id="shout" style="loud" tts:fontSize="120%"/>
      <style xml:id="regionBottom" tts:displayAlign="after" tts:textAlign="center"/>
    </styling>
    <layout>
      <region xml:id="bottom" style="regionBottom" tts:origin="10% 70%" tts:extent="80% 25%"/>
      <region xml:id="top" tts:origin="10% 5%" tts:extent="80% 15%"
              tts:displayAlign="before" tts:textAlign="center" tts:backgroundColor="#00000080"/>
    </layout>
  </head>
  <body style="base">
    <div>
      <!-- inheritance: body->div->p; style chain: base -> loud -> local attrs -->
      <p xml:id="p1" region="bottom" begin="0s" end="3s" ttm:agent="narrator"
         style="loud" tts:fontStyle="italic">Once upon a time<br/>in a far away land</p>
      <!-- chained style ref: shout itself references loud -->
      <p xml:id="p2" region="bottom" begin="3s" end="6s" ttm:agent="alice"
         style="shout">Alice said <span tts:color="cyan">hello</span> loudly</p>
      <!-- multi-line cue with mixed runs, speaker change mid-cue -->
      <p xml:id="p3" region="bottom" begin="6s" end="10s" ttm:agent="alice">Line one is hers<br/>
        <span ttm:agent="narrator" tts:fontStyle="italic">line two is narrated</span><br/>
        <span style="loud">line three is bold yellow</span></p>
      <!-- top region cue overlapping p3 in time: simultaneous multi-region -->
      <p xml:id="p4" region="top" begin="7s" end="9s">[THUNDER RUMBLING]</p>
    </div>
  </body>
</tt>
