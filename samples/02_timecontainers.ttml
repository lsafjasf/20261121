<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml"
    xmlns:tts="http://www.w3.org/ns/ttml#styling"
    xmlns:ttp="http://www.w3.org/ns/ttml#parameter"
    xmlns:ttm="http://www.w3.org/ns/ttml#metadata"
    xmlns:xml="http://www.w3.org/XML/1998/namespace"
    ttp:frameRate="30" ttp:frameRateMultiplier="1000 1001"
    ttp:cellResolution="32 18" xml:lang="en">
  <head>
    <metadata>
      <ttm:agent xml:id="bob" type="person"><ttm:name type="full">Bob</ttm:name></ttm:agent>
    </metadata>
    <styling>
      <style xml:id="cap" tts:fontFamily="sansSerif" tts:fontSize="100%" tts:color="white"
             tts:backgroundColor="#000000A0"/>
    </styling>
    <layout>
      <region xml:id="lower" tts:origin="15% 72%" tts:extent="70% 22%"
              tts:displayAlign="after" tts:textAlign="center"/>
      <region xml:id="upperLeft" tts:origin="5% 8%" tts:extent="40% 12%"
              tts:displayAlign="before" tts:textAlign="start"/>
    </layout>
  </head>
  <!-- seq container: children play back-to-back; migrator must flatten to absolute par timing -->
  <body timeContainer="par">
    <div timeContainer="seq" region="lower" style="cap">
      <p xml:id="s1" dur="1.5s" ttm:agent="bob">First in sequence</p>
      <p xml:id="s2" dur="45f" ttm:agent="bob">Second, timed in frames</p>
      <!-- fractional frame in-point: 1.5s + 45f @29.97 then + 10.5f -->
      <p xml:id="s3" begin="10.5f" dur="2s" ttm:agent="bob">Third, offset by 10.5 frames</p>
      <div timeContainer="par" dur="1.5s">
        <p xml:id="s4" begin="0s" dur="1s">Nested par A</p>
        <p xml:id="s5" begin="0.25f" dur="1s" region="upperLeft">Nested par B (other region)</p>
      </div>
    </div>
    <!-- simultaneous multi-region against the seq block -->
    <div timeContainer="par">
      <p xml:id="m1" region="upperLeft" begin="1s" end="2.5s" style="cap">[MUSIC PLAYING]</p>
      <!-- timed span: not allowed in IMSC, must be degraded -->
      <p xml:id="m2" region="lower" begin="4s" end="6s" style="cap">Word <span begin="1s" end="1.5s" tts:color="lime">pop</span> test</p>
    </div>
  </body>
</tt>
