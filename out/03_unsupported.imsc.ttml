<?xml version='1.0' encoding='UTF-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" ttp:frameRate="25" xml:lang="en" ttp:contentProfiles="http://www.w3.org/ns/ttml/profile/imsc1.1/text">
  <head>
    <styling>
      <style xml:id="twoD" tts:fontSize="80%" />
      <style xml:id="shadowed" tts:color="white" />
      <style xml:id="vertical" tts:writingMode="tbrl" />
    </styling>
    <layout>
      <region xml:id="r1" tts:origin="10% 75%" tts:extent="80% 20%" tts:displayAlign="after" tts:textAlign="center" />
    </layout>
  </head>
  <body>
    <div region="r1">
      <p xml:id="u1" begin="00:00:00.000" end="00:00:04.000">Blinking
        
        
        warning</p>
      <p xml:id="u2" style="twoD" begin="00:00:04.000" end="00:00:06.000">Stretched glyphs</p>
      <p xml:id="u3" style="shadowed" begin="00:00:06.000" end="00:00:08.000">Soft drop shadow</p>
      <p xml:id="u4" tts:textAlign="start" begin="00:00:08.000" end="00:00:10.000">Multi row<br />alignment</p>
      <p xml:id="u5" begin="00:00:10.000" end="00:00:12.000">Translated sign</p>
      <p xml:id="u6" style="vertical" begin="00:00:12.000" end="00:00:14.000">Vertical text</p>
      <p xml:id="u7" begin="00:00:14.000" end="00:00:16.000">
        
        Has foreign metadata</p>
    </div>
  </body>
</tt>