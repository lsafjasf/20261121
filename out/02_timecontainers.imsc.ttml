<?xml version='1.0' encoding='UTF-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" ttp:frameRate="30" ttp:frameRateMultiplier="1000 1001" ttp:cellResolution="32 18" xml:lang="en" ttp:contentProfiles="http://www.w3.org/ns/ttml/profile/imsc1.1/text">
  <head>
    <metadata>
      <ttm:agent xml:id="bob" type="person">
        <ttm:name type="full">Bob</ttm:name>
      </ttm:agent>
    </metadata>
    <styling>
      <style xml:id="cap" tts:fontFamily="sansSerif" tts:fontSize="100%" tts:color="white" tts:backgroundColor="#000000A0" />
    </styling>
    <layout>
      <region xml:id="lower" tts:origin="15% 72%" tts:extent="70% 22%" tts:displayAlign="after" tts:textAlign="center" />
      <region xml:id="upperLeft" tts:origin="5% 8%" tts:extent="40% 12%" tts:displayAlign="before" tts:textAlign="start" />
    </layout>
  </head>
  <body>
    <div region="lower" style="cap">
      <p xml:id="s1" ttm:agent="bob" begin="00:00:00.000" end="00:00:01.500">First in sequence</p>
      <p xml:id="s2" ttm:agent="bob" begin="00:00:01.500" end="00:00:03.002">Second, timed in frames</p>
      <p xml:id="s3" ttm:agent="bob" begin="00:00:03.352" end="00:00:05.352">Third, offset by 10.5 frames</p>
      <div>
        <p xml:id="s4" begin="00:00:05.352" end="00:00:06.352">Nested par A</p>
        <p xml:id="s5" region="upperLeft" begin="00:00:05.360" end="00:00:06.360">Nested par B (other region)</p>
      </div>
    </div>
    <div>
      <p xml:id="m1" region="upperLeft" style="cap" begin="00:00:01.000" end="00:00:02.500">[MUSIC PLAYING]</p>
      <p xml:id="m2" region="lower" style="cap" begin="00:00:04.000" end="00:00:06.000">Word <span tts:color="lime">pop</span> test</p>
    </div>
  </body>
</tt>