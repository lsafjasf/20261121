<?xml version='1.0' encoding='UTF-8'?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" ttp:frameRate="25" ttp:cellResolution="32 18" xml:lang="en" ttp:contentProfiles="http://www.w3.org/ns/ttml/profile/imsc1.1/text">
  <head>
    <metadata>
      <ttm:agent xml:id="narrator" type="person">
        <ttm:name type="full">Narrator</ttm:name>
      </ttm:agent>
      <ttm:agent xml:id="alice" type="person">
        <ttm:name type="full">Alice</ttm:name>
      </ttm:agent>
    </metadata>
    <styling>
      <style xml:id="base" tts:fontFamily="sansSerif" tts:fontSize="100%" tts:color="white" />
      <style xml:id="loud" tts:fontWeight="bold" tts:color="yellow" />
      <style xml:id="shout" style="loud" tts:fontSize="120%" />
      <style xml:id="regionBottom" tts:displayAlign="after" tts:textAlign="center" />
    </styling>
    <layout>
      <region xml:id="bottom" style="regionBottom" tts:origin="10% 70%" tts:extent="80% 25%" />
      <region xml:id="top" tts:origin="10% 5%" tts:extent="80% 15%" tts:displayAlign="before" tts:textAlign="center" tts:backgroundColor="#00000080" />
    </layout>
  </head>
  <body style="base">
    <div>
      <p xml:id="p1" region="bottom" ttm:agent="narrator" style="loud" tts:fontStyle="italic" begin="00:00:00.000" end="00:00:03.000">Once upon a time<br />in a far away land</p>
      <p xml:id="p2" region="bottom" ttm:agent="alice" style="shout" begin="00:00:03.000" end="00:00:06.000">Alice said <span tts:color="cyan">hello</span> loudly</p>
      <p xml:id="p3" region="bottom" ttm:agent="alice" begin="00:00:06.000" end="00:00:10.000">Line one is hers<br />
        <span ttm:agent="narrator" tts:fontStyle="italic">line two is narrated</span>
        <br />
        <span style="loud">line three is bold yellow</span>
      </p>
      <p xml:id="p4" region="top" begin="00:00:07.000" end="00:00:09.000">[THUNDER RUMBLING]</p>
    </div>
  </body>
</tt>